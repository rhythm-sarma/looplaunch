# ──────────────────────────────────────────────
# Loop Launch — Environment Variables Template
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.

# Google Gemini API Key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Crawl4AI Service URL (required for website crawling)
# Local Docker: http://localhost:11235
# Render: https://your-crawl4ai-service.onrender.com
CRAWL4AI_URL=http://localhost:11235

# Tavily Search API Key (optional — for market research)
TAVILY_API_KEY=

# Supabase Connection (required for persistent storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Production Site URL (used for sitemap, canonical links, and Open Graph previews)
# e.g., https://looplaunch.co or https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://looplaunch.co

# Google Search Console Verification code (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics measurement ID (optional; overrides the one in code, tag loads in production only)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Invite-only access: comma-separated emails that can use the real app (everyone else sees the waitlist).
# Optional; defaults to work@looplaunch.co,rhythmsarma66@gmail.com,lordsimp234@gmail.com,loop.launchx@gmail.com
TEAM_EMAILS=work@looplaunch.co,rhythmsarma66@gmail.com,lordsimp234@gmail.com,loop.launchx@gmail.com
# Waitlist is on unless this is "off". Off: anyone can run an analysis; signed-out visitors get
# their 7-day strategy, then must log in to keep chatting and to see the search intel.
WAITLIST_MODE=on

# Search Intel research budget (optional; these are the defaults). Ceilings, never targets.
MAX_INITIAL_QUESTIONS=10
MAX_INITIAL_ADS=10
MAX_INITIAL_COMPETITORS=10
# Paid SerpApi searches per analysis (cached results are free): discovery + competitor ads + Ad Library
MAX_COMPETITOR_DISCOVERY_QUERIES=2
MAX_AD_SEARCH_QUERIES=3
MAX_AD_LIBRARY_LOOKUPS=2
MAX_RESEARCH_RETRIES=1
# How long provider results are reused (needs migration 007 to survive restarts)
RESEARCH_CACHE_TTL_HOURS=72
# SerpApi engine for Google searches: google_ads (default; returns ads + organic + questions) or google
SERPAPI_SEARCH_ENGINE=google_ads

# ─── Daily agenda from Google Calendar (Settings → Daily agenda; needs migration 012) ───
# Shows "Coming soon" until this is "on". Turn it on once Google has verified the app
# (before that, only the test users listed in Google Cloud can connect).
GOOGLE_CALENDAR_LAUNCH=
# OAuth client from Google Cloud → Google Auth Platform → Clients (type: Web application).
# Turn on the Google Calendar API in the same project. Both are needed for the Connect button.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Must be one of the client's "Authorised redirect URIs", exactly. Defaults to NEXT_PUBLIC_SITE_URL + /oauth/callback,
# so production can leave it empty; set it to http://localhost:3000/oauth/callback in .env.local.
GOOGLE_CALENDAR_REDIRECT_URI=
# Encrypts the stored Google tokens. 32 random bytes, base64. Never change it once people have connected
# (they'd have to connect again). Make one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_KEY=
# The app sends the morning agendas itself: the server checks every 10 minutes who's due (src/lib/calendar/scheduler.ts).
# On in production by default; off in development unless set to "on". Set "off" if an outside cron job does it instead.
AGENDA_SCHEDULER=
# Optional, for an outside scheduler instead: protects /api/cron/daily-agenda.
# Call it every hour with the header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Email delivery through Brevo's API (Brevo → SMTP & API → API keys). The from address must be a verified sender.
BREVO_API_KEY=
AGENDA_EMAIL_FROM=
AGENDA_EMAIL_FROM_NAME=Loop Launch
# WhatsApp delivery (optional) through Meta's WhatsApp Cloud API, with an approved Utility template whose body
# has two fields: {{1}} the date and {{2}} the day's events, e.g. "Here's your plan for {{1}}: {{2}}"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_AGENDA_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_VERSION=v23.0
